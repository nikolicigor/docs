{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Project-level Claude Code settings for the public docs site. Same posture as the BE and FE repos.",

  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push * main)",
      "Bash(git push --force origin main*)",
      "Bash(git push -f origin main*)",
      "Bash(git push --force-with-lease origin main*)",
      "Bash(git push --no-verify *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git rebase -i *)",
      "Bash(git reset --hard origin/main)",
      "Bash(git reset --hard main)",
      "Bash(git config user.* *)",
      "Bash(git config --global *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit -F *)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin docs/*)",
      "Bash(git fetch *)",
      "Bash(git pull --rebase *)",
      "Bash(git stash *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(node -e *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find . -type f *)",
      "Bash(find . -type d *)",
      "Bash(ls *)",
      "Bash(mintlify dev)",
      "Bash(mintlify build)",
      "Bash(npx mintlify *)",
      "WebFetch(domain:mintlify.com)",
      "WebFetch(domain:docs.stripe.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "additionalDirectories": [
      "/Users/Nikolic-Marko/FileFeed/filefeed-backend",
      "/Users/Nikolic-Marko/FileFeed/filefeed-backend/filefeed-sdk",
      "/Users/Nikolic-Marko/FileFeed/filefeed-frontend"
    ]
  }
}
